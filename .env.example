# Copy this file to .env and paste your key after the equals sign.
OPENAI_API_KEY=

# Optional settings (defaults shown)
# OPENAI_MODEL=gpt-6-luna
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BACKEND=openai

# --- WhatsApp (only needed for `python whatsapp.py`; see README) ---
# From Meta's App Dashboard, API Setup page:
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# From App settings > Basic > App secret:
# WHATSAPP_APP_SECRET=
# Any password-like string you invent; you type the same one into Meta's webhook form:
# WHATSAPP_VERIFY_TOKEN=
# Optional: your own WhatsApp number (digits with country code, e.g. +972501234567).
# Messages from it are treated as the first sample customer, so order questions have data.
# DEMO_MY_NUMBER=

# --- Server (only needed for deploy/upload.ps1; see README) ---
# Your ngrok authtoken, so the server can open your fixed address:
# NGROK_AUTHTOKEN=
